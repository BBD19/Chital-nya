<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BookInterface.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BookInterface"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Читальня">

    <!-- Выключаем темную тему -->
    <Grid Background="#F1F5F9" RequestedTheme="Light">

        <SplitView x:Name="RootSplitView" 
                   DisplayMode="Overlay" 
                   OpenPaneLength="280" 
                   PaneBackground="#FFFFFF">

            <!-- Выезжающее меню -->
            <SplitView.Pane>
                <Grid Padding="20" Background="#F8FAFC">
                    <StackPanel Spacing="15">

                        <!-- Заголовок Меню -->
                        <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,0,0,20">
                            <Button Click="OnMenuClicked" Background="Transparent" BorderBrush="Transparent">
                                <FontIcon Glyph="&#xE700;" FontSize="20" Foreground="#1E293B"/>
                            </Button>
                            <TextBlock Text="Читальня · Меню" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Foreground="#1E293B"/>
                        </StackPanel>

                        <!-- Кнопка "Главное меню" -->
                        <Button Content="Главное меню" Click="OnMainMenuClicked" FontWeight="Bold" HorizontalAlignment="Stretch" Height="48" 
                    CornerRadius="10" Background="White" BorderBrush="#E2E8F0" Foreground="#1E293B" Translation="0,0,8">
                            <Button.Shadow>
                                <ThemeShadow />
                            </Button.Shadow>
                        </Button>


                        <!-- Кнопка "Мой аккаунт" -->
                        <Button Content="Мой аккаунт" Click="OnAccountClicked" FontWeight="Bold" HorizontalAlignment="Stretch" Height="48" 
        CornerRadius="10" Background="White" BorderBrush="#E2E8F0" Foreground="#1E293B" Translation="0,0,8">
                            <Button.Shadow>
                                <ThemeShadow />
                            </Button.Shadow>
                        </Button>

                        <!-- Кнопка "Мои книги" -->
                        <Button Content="Мои книги" FontWeight="Bold" HorizontalAlignment="Stretch" Height="48" 
                    CornerRadius="10" Background="White" BorderBrush="#E2E8F0" Foreground="#1E293B" Translation="0,0,8">
                            <Button.Shadow>
                                <ThemeShadow />
                            </Button.Shadow>
                        </Button>

                        <!-- Кнопка "Инструкция" -->
                        <Button Content="Инструкция" FontWeight="Bold" HorizontalAlignment="Stretch" Height="48" 
                    CornerRadius="10" Background="White" BorderBrush="#E2E8F0" Foreground="#1E293B" Translation="0,0,8">
                            <Button.Shadow>
                                <ThemeShadow />
                            </Button.Shadow>
                        </Button>

                        <!-- Кнопка "Каталог" -->
                        <Button Content="Каталог" FontWeight="Bold" HorizontalAlignment="Stretch" Height="48" 
                    CornerRadius="10" Background="White" BorderBrush="#E2E8F0" Foreground="#1E293B" Translation="0,0,8">
                            <Button.Shadow>
                                <ThemeShadow />
                            </Button.Shadow>
                        </Button>

                    </StackPanel>
                </Grid>
            </SplitView.Pane>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Вверх главно страницы -->
                <Grid Grid.Row="0" Background="White" Padding="20,10,20,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <!-- Лево: Меню -->
                        <ColumnDefinition Width="*"/>
                        <!-- Центр: Поиск -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Право: Заглушка для баланса -->
                    </Grid.ColumnDefinitions>

                    <!-- Меню и название -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="15">
                        <Button Click="OnMenuClicked" Background="Transparent" BorderBrush="Transparent">
                            <FontIcon Glyph="&#xE700;" FontSize="22" Foreground="#1E293B"/>
                        </Button>
                        <TextBlock Text="Читальня" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Foreground="#1E293B"/>
                    </StackPanel>

                    <!-- Меню поиска -->
                    <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Background="White" 
                            BorderBrush="#D1D8E0" 
                            BorderThickness="1" 
                            CornerRadius="10" 
                            Width="500"
                            Height="40">
                            <!-- Тень  -->
                            <Border.Shadow>
                                <ThemeShadow />
                            </Border.Shadow>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Иконка лупы слева -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- Поле ввода -->
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Кнопка поиска -->
                                </Grid.ColumnDefinitions>

                                <!-- Иконка лупы (не работающая) -->
                                <FontIcon Glyph="&#xE721;" 
                                   FontSize="14" 
                                   Foreground="Gray" 
                                   Margin="12,0,8,0" 
                                   VerticalAlignment="Center"/>

                                <!-- Поле ввода -->
                                <TextBox Grid.Column="1" 
                                    PlaceholderText="Введите название книги или автора..." 
                                    BorderThickness="0" 
                                    Background="Transparent"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Foreground="Black"
                                    FontSize="14"/>

                                <!-- Блок с лупой -->
                                <StackPanel Grid.Column="2" 
                                    Orientation="Horizontal" 
                                    Background="#DDE2E8" 
                                    CornerRadius="0,10,10,0" 
                                    Padding="5,0">

                                    <!-- Кнопка Найти-Лупы -->
                                    <Button Background="Transparent" BorderThickness="0" Padding="10,0">
                                        <FontIcon Glyph="&#xE721;" FontSize="16" Foreground="#5E6C7A"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                </Grid>

                <!-- Карточки с книгами -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" Padding="40,20,40,20">
                        <StackPanel Spacing="30">
                            <!-- Последние новости -->
                            <Grid HorizontalAlignment="Center" Margin="0,10,0,10">
                                <StackPanel Orientation="Horizontal" Spacing="20">
                                    <Rectangle Width="100" Height="2" Fill="#46C6BA" Opacity="0.3" VerticalAlignment="Center"/>
                                    <TextBlock Text="Последние новости" Foreground="#46C6BA" FontSize="20" FontWeight="SemiBold"/>
                                    <Rectangle Width="100" Height="2" Fill="#46C6BA" Opacity="0.3" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Топ 67 - месяца" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#1E293B"/>

                            <!-- Номер и карточка книги -->
                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <!-- Место под большую цифру 1. -->
                                    <ColumnDefinition Width="*" />
                                    <!-- Белая карточка -->
                                </Grid.ColumnDefinitions>

                                <!-- Цифра 1. -->
                                <TextBlock Text="1." 
                                    FontSize="82" 
                                    FontWeight="Black" 
                                    Foreground="#acadaf" 
                                    VerticalAlignment="Center" 
                                    HorizontalAlignment="Center"
                                    Margin="0,0,10,0"/>

                                <!-- Карточка белая -->
                                <Border Grid.Column="1" 
                                    Background="White" 
                                    CornerRadius="18" 
                                    Padding="18" 
                                    BorderBrush="#E8ECEF" 
                                    BorderThickness="1">

                                    <!-- Тень  -->
                                    <Border.Shadow>
                                        <ThemeShadow />
                                    </Border.Shadow>

                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <!-- Обложка -->
                                            <ColumnDefinition Width="*" />
                                            <!-- Текст -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Обложка книги -->
                                        <Rectangle Grid.Column="0" 
                                            Width="160" 
                                            Height="220" 
                                            Fill="#FFD8A8" 
                                            RadiusX="10" 
                                            RadiusY="10" />

                                        <!-- Информация книги -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Spacing="2">

                                            <!-- Название книги -->
                                            <TextBlock Text="Дети Дюны" 
                                                FontSize="26" 
                                                FontWeight="Bold" 
                                                Foreground="Black" 
                                                Margin="0,0,0,2"/>

                                            <!-- Рейтинг -->
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                                                <FontIcon Glyph="&#xE735;" FontSize="16" Foreground="#FFB347" VerticalAlignment="Center"/>
                                                <TextBlock Text="9.7/10" 
                                                FontSize="18" 
                                                FontWeight="Bold" 
                                                Foreground="#FFB347" 
                                                VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Жанр -->
                                            <TextBlock Text="Жанр: фантастика, приключения, драма" 
                                                FontSize="15" 
                                                FontWeight="SemiBold" 
                                                Foreground="#2D6A61" 
                                                Margin="0,0,0,5"/>

                                            <!-- Описание -->
                                            <TextBlock Text="Описание: Прошло 12 лет с тех пор, как Пол Муад-Диб Атрейдес, житель пустыни, задумал подчинить себе империю. За эти годы все известные планеты попали под власть Пола..." 
                                               TextWrapping="Wrap" 
                                               FontSize="15" 
                                               Foreground="#222222" 
                                               LineHeight="20"/>

                                            <!-- Маленький текст внизу -->
                                            <TextBlock Text="Прочли 7 раз" 
                                               FontSize="12" 
                                               Foreground="#888888" 
                                               Margin="0,50,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Последние оценки -->
                    <Border Grid.Column="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1,0,0,0">
                        <ScrollViewer Padding="25">
                            <StackPanel Spacing="15">

                                <!-- Заголовок -->
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,15">
                                    <!-- Желтая звезда -->
                                    <FontIcon Glyph="&#xE735;" 
                                    FontSize="36" 
                                    Foreground="#FFD700" 
                                    VerticalAlignment="Center"/>
                                    <TextBlock Text="Последние оценки" 
                                    FontSize="26" 
                                    FontWeight="Bold" 
                                    Foreground="#1E293B" 
                                    VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Карточка книги -->
                                <Border Background="White" 
                                    CornerRadius="15" 
                                    Padding="15" 
                                    BorderBrush="#F0F0F0" 
                                    BorderThickness="1"
                                    Translation="0,0,8">
                                    <!-- Тень -->
                                    <Border.Shadow>
                                        <ThemeShadow />
                                    </Border.Shadow>

                                    <Grid ColumnSpacing="15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="85" />
                                            <!-- Маленькая обложка -->
                                            <ColumnDefinition Width="*" />
                                            <!-- Текст -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Маленькая обложка  -->
                                        <Rectangle Grid.Column="0" 
                                           Width="85" 
                                           Height="120" 
                                           Fill="#FF726F" 
                                           RadiusX="8" 
                                           RadiusY="8" />

                                        <!-- Текст с информацией -->
                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <!-- Текст -->
                                                <RowDefinition Height="Auto" />
                                                <!-- Время -->
                                            </Grid.RowDefinitions>

                                            <!-- Название -->
                                            <StackPanel Grid.Row="0" Spacing="1">
                                                <TextBlock Text="451 градус по Фаренгейту" 
                                                   FontWeight="Bold" 
                                                   FontSize="15" 
                                                   TextWrapping="Wrap" 
                                                   Foreground="Black"/>

                                                <!-- Рейтинг -->
                                                <TextBlock Text="9/10" 
                                                   Foreground="#D97706" 
                                                   FontSize="14"
                                                   FontWeight="Bold" 
                                                   VerticalAlignment="Center"/>

                                                <!-- Жанр -->
                                                <TextBlock Text="Жанр: драма, фантастика" 
                                                   Foreground="#2D6A61" 
                                                   FontSize="12" 
                                                   FontWeight="SemiBold"
                                                   Margin="0,2,0,0"/>

                                                <!-- Описание -->
                                                <TextBlock Text="Описание: В каком-то тоталитарном обществе..." 
                                                   FontSize="12" 
                                                   Foreground="#333333" 
                                                   TextWrapping="Wrap" 
                                                   MaxLines="2"
                                                   Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Время последнего прочитания -->
                                            <TextBlock Grid.Row="1" 
                                               Text="1 час назад" 
                                               FontSize="11" 
                                               Foreground="Gray" 
                                               HorizontalAlignment="Right" 
                                               VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </SplitView>
        <!-- Оверлей регистрации и входа -->
        <Grid x:Name="AuthOverlay" Visibility="Collapsed" Background="White">
            <StackPanel Width="500" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,100,0,0" Spacing="30">

                <!-- Крестки и сами вкладки и текст -->
                <Grid x:Name="AuthHeader">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Click="OnCloseAuthClicked" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Top">
                        <FontIcon Glyph="&#xE711;" FontSize="24" Foreground="#1E293B"/>
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="40">
                        <!-- Вкладка Вход -->
                        <StackPanel x:Name="LoginTab" PointerPressed="ShowLogin" Background="Transparent">
                            <TextBlock x:Name="LoginTabText" Text="Вход" FontSize="28" FontWeight="Bold" Foreground="#36545D"/>
                            <Rectangle x:Name="LoginUnderline" Height="3" Fill="#36545D" Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- Вкладка Регистрация -->
                        <StackPanel x:Name="RegisterTab" PointerPressed="ShowRegister" Background="Transparent">
                            <TextBlock x:Name="RegisterTabText" Text="Регистрация" FontSize="28" FontWeight="Bold" Foreground="#64748B"/>
                            <Rectangle x:Name="RegisterUnderline" Height="3" Fill="#36545D" Margin="0,5,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Заголовок "Забыли пароль?" -->
                <Grid x:Name="ForgotHeader" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Крестик возвращает назад в меню входа -->
                    <Button Click="OnBackToLoginClicked" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Top">
                        <FontIcon Glyph="&#xE711;" FontSize="24" Foreground="#1E293B"/>
                    </Button>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="Забыли пароль?" FontSize="28" FontWeight="Bold" Foreground="#36545D"/>
                        <Rectangle Height="3" Fill="#36545D" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Поля вкладки "Вход" -->
                <StackPanel x:Name="LoginFields" Spacing="20" Visibility="Visible">
                    <TextBox PlaceholderText="Номер телефона..." Height="50" CornerRadius="8" Background="#F8F8F8" BorderBrush="#F0F0F0"/>
                    <PasswordBox PlaceholderText="Пароль..." Height="50" CornerRadius="8" Background="#F8F8F8" BorderBrush="#F0F0F0"/>
                    <Button Content="Войти" HorizontalAlignment="Stretch" Height="50" Background="#36545D" Foreground="White" CornerRadius="25" FontWeight="Bold" Margin="0,20,0,0"/>
                    <TextBlock x:Name="ForgotBtn" Text="Забыли пароль?" PointerPressed="OnForgotClicked" Foreground="#36545D" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Поля вкладки "Регистрация" -->
                <StackPanel x:Name="RegisterFields" Spacing="15" Visibility="Collapsed">
                    <TextBox PlaceholderText="Имя..." Height="45" CornerRadius="8" Background="#F8F8F8" BorderBrush="#F0F0F0"/>
                    <TextBox PlaceholderText="Фамилия..." Height="45" CornerRadius="8" Background="#F8F8F8" BorderBrush="#F0F0F0"/>
                    <TextBox PlaceholderText="Номер читательского билета..." Height="45" CornerRadius="8" Background="#F8F8F8" BorderBrush="#F0F0F0"/>
                    <TextBox PlaceholderText="Номер телефона..." Height="45" CornerRadius="8" Background="#F8F8F8" BorderBrush="#F0F0F0"/>
                    <PasswordBox PlaceholderText="Пароль..." Height="45" CornerRadius="8" Background="#F8F8F8" BorderBrush="#F0F0F0"/>
                    <Button Content="Зарегистрироваться" HorizontalAlignment="Stretch" Height="50" Background="#36545D" Foreground="White" CornerRadius="25" FontWeight="Bold" Margin="0,20,0,0"/>
                </StackPanel>

                <!-- Поля вкладки "Забыли пароль?" -->
                <StackPanel x:Name="ForgotFields" Spacing="20" Visibility="Collapsed" Margin="0,40,0,0">
                    <TextBlock Text="Для восстановления доступа или уточнения данных, пожалуйста, обратитесь к библиотекорше." 
                       FontSize="16" Foreground="#1E293B" TextWrapping="Wrap" LineHeight="24"/>
                </StackPanel>
                
            </StackPanel>
        </Grid>
    </Grid>
</Window>